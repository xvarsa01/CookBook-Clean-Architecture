<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:CookBook.CleanArch.Presentation.MauiApplication.Views"
                       xmlns:xaml="clr-namespace:Microsoft.Maui.Controls.Xaml;assembly=Microsoft.Maui.Controls.Xaml"
                       xmlns:texts="clr-namespace:CookBook.CleanArch.Presentation.MauiApplication.Resources.Texts"
                       xmlns:viewModels="clr-namespace:CookBook.CleanArch.Presentation.MauiApplication.ViewModels"
                       xmlns:models="using:CookBook.CleanArch.Application.Recipes.Models"
                       xmlns:rs="using:CookBook.CleanArch.Presentation.MauiApplication.Resources.Fonts"
                       xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                       x:Class="CookBook.CleanArch.Presentation.MauiApplication.Views.Recipe.RecipeDetailView"
                       Title="{xaml:Static texts:RecipeDetailViewTexts.Page_Title}"
                       Style="{StaticResource ContentPageStyle}"
                       x:Name="RecipeDetailViewRoot"
                       x:DataType="viewModels:RecipeDetailViewModel">

    <Grid ColumnDefinitions="*, Auto"
          ColumnSpacing="20">
        <ScrollView Orientation="Vertical"
                    VerticalScrollBarVisibility="Never">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *"
                  RowSpacing="20">
                <Label Grid.Row="0"
                       Text="{Binding Recipe.Name.Value}"
                       TextColor="{StaticResource PrimaryLabelTextColor}"
                       FontSize="20" />

                <Border Grid.Row="1"
                        BackgroundColor="{Binding Recipe.Type, Converter={StaticResource FoodTypeToColorConverter}}"
                        HeightRequest="100">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *"
                          HorizontalOptions="Fill" VerticalOptions="Center"
                          RowSpacing="5">

                        <Label Grid.Row="1" Grid.Column="0"
                               HorizontalOptions="Center" VerticalOptions="Start"
                               Text="{Binding Recipe.Type, Converter={StaticResource FoodTypeToStringConverter}}"
                               FontSize="11"
                               TextColor="White" />

                        <Label Grid.Row="1" Grid.Column="1"
                               HorizontalOptions="Center" VerticalOptions="Start"
                               Text="{Binding Recipe.Duration.Value, Converter={StaticResource RecipeDurationToStringConverter}}"
                               FontSize="11"
                               TextColor="White" />

                        <Label Grid.Row="1" Grid.Column="2"
                               HorizontalOptions="Center" VerticalOptions="Start"
                               Text="{Binding Recipe.Ingredients.Count, Converter={StaticResource RecipeIngredientsCountToStringConverter}}"
                               TextColor="White"
                               FontSize="11" />
                    </Grid>
                </Border>

                <Label Grid.Row="2"
                       Text="{x:Static texts:RecipeDetailViewTexts.Description_Label_Text}"
                       FontSize="16" />

                <Label Grid.Row="3"
                       Text="{Binding Recipe.Description}"
                       FontSize="14" />
                
                <Grid Grid.Row="4"
                      RowDefinitions="Auto, Auto, *"
                      ColumnDefinitions="*,*"
                      RowSpacing="20">
                    <Label Grid.Column="0"
                           Grid.Row="0"
                           Text="{x:Static texts:RecipeDetailViewTexts.Ingredients_Label_Text}"
                           FontSize="16" />
                    <CollectionView Grid.Column="0"
                                    Grid.Row="1"
                                    Grid.RowSpan="2"
                                    ItemsSource="{Binding Recipe.Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeIngredientResponse">
                                <HorizontalStackLayout>
                                    <Border Margin="5, 5, 20, 5"
                                            Style="{StaticResource ImageBorderStyle}">
                                        <Image Source="{Binding IngredientImageUrl.Value, TargetNullValue='ingredient_placeholder.jpg'}"
                                               WidthRequest="60" HeightRequest="60"
                                               Aspect="AspectFill" />
                                        
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference RecipeDetailViewRoot}, Path=BindingContext.GoToIngredientDetailCommand}"
                                                                  CommandParameter="{Binding IngredientId}" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Label VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Amount.Value}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Unit, Converter={StaticResource UnitToStringConverter}}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding IngredientName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Label Grid.Column="1"
                           Grid.Row="0"
                           Text="{x:Static texts:RecipeDetailViewTexts.Reviews_Label_Text}"
                           FontSize="16" />
                    <Grid Grid.Column="1"
                          Grid.Row="1"
                          RowSpacing="10"
                          ColumnSpacing="10"
                          ColumnDefinitions="Auto, *, Auto"
                          RowDefinitions="Auto, Auto, Auto">

                        <Label Grid.Column="0"
                               Grid.Row="0"
                               Text="Mark" />
                        <Entry Grid.Column="0"
                               Grid.Row="1"
                               Text="{Binding ReviewNew.Mark}">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior EventName="TextChanged"
                                                                Command="{Binding ValidateNewReviewCommand}" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Grid.Column="0"
                               Grid.Row="2"
                               Style="{StaticResource ValidationErrorLabelStyle}"
                               Text="{Binding ReviewNew.ValidationResults,
                                            Converter={StaticResource ValidationResultToErrorMessagesConverter}, 
                                            ConverterParameter={x:Static viewModels:RecipeReviewListModel.ReviewMarkProperty}}"
                               IsVisible="{Binding ReviewNew.ValidationResults, 
                                            Converter={StaticResource ValidationResultToHasErrorConverter}, 
                                            ConverterParameter={x:Static viewModels:RecipeReviewListModel.ReviewMarkProperty}}" />
                        
                        <Label Grid.Column="1"
                               Grid.Row="0"
                               Text="Description" />
                        <Entry Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding ReviewNew.Description}">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior EventName="TextChanged"
                                                                Command="{Binding ValidateNewReviewCommand}" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Grid.Column="1"
                               Grid.Row="2"
                               Style="{StaticResource ValidationErrorLabelStyle}"
                               Text="{Binding ReviewNew.ValidationResults,
                                            Converter={StaticResource ValidationResultToErrorMessagesConverter}, 
                                            ConverterParameter={x:Static viewModels:RecipeReviewListModel.ReviewDescriptionProperty}}"
                               IsVisible="{Binding ReviewNew.ValidationResults, 
                                            Converter={StaticResource ValidationResultToHasErrorConverter}, 
                                            ConverterParameter={x:Static viewModels:RecipeReviewListModel.ReviewDescriptionProperty}}" />
                        
                        <Button Grid.Column="2"
                                Grid.Row="1"
                                Text="Add"
                                Command="{Binding AddReviewCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                    <CollectionView Grid.Column="1"
                                    Grid.Row="2"
                                    ItemsSource="{Binding Recipe.Reviews}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeReviewResponse">
                                <Grid ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="10"
                                      Padding="5">
                                    <Label Grid.Column="0"
                                           Text="{Binding Mark}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Description}" />
                                    <Button Grid.Column="2"
                                            HorizontalOptions="Start" VerticalOptions="Center"
                                            Text="{x:Static texts:RecipeDetailViewTexts.RemoveReview_Button_Text}"
                                            Command="{Binding Source={x:Reference RecipeDetailViewRoot}, Path=BindingContext.RemoveReviewCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ErrorButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </ScrollView>

        <VerticalStackLayout Grid.Column="1"
                             Spacing="20">
            <Grid ColumnDefinitions="*, Auto, Auto"
                  ColumnSpacing="15">
                <Button Grid.Column="1"
                        VerticalOptions="Start"
                        HeightRequest="30"
                        FontFamily="{x:Static rs:FontKeys.IconsFont}"
                        Text="{x:Static rs:IconKeys.Delete}"
                        CornerRadius="5"
                        BackgroundColor="{StaticResource ErrorColor}"
                        Command="{Binding DeleteCommand}" />

                <Button Grid.Row="0"
                        HorizontalOptions="End" VerticalOptions="Start"
                        HeightRequest="30"
                        FontFamily="{x:Static rs:FontKeys.IconsFont}"
                        Text="{x:Static rs:IconKeys.Edit}"
                        CornerRadius="5"
                        Command="{Binding GoToEditCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
            <Border Style="{StaticResource ImageBorderStyle}">
                <Image Source="{Binding Recipe.ImageUrl.Value, TargetNullValue='recipe_placeholder.jpg'}"
                       WidthRequest="320" HeightRequest="240"
                       Aspect="AspectFill" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</views:ContentPageBase>
