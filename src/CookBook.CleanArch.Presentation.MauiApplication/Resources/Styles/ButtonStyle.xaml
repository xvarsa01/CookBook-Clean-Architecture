<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui">
    
    <Style x:Key="ButtonStyleBase" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="MontserratMedium" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    
    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button" 
           BasedOn="{StaticResource ButtonStyleBase}">
        <Setter Property="TextColor" Value="{StaticResource PrimaryButtonTextColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        
        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                <Setter Property="TextColor" Value="{StaticResource DisabledTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ErrorButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonStyleBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
    </Style>
    
    <Style TargetType="controls:RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource PrimaryLabelTextColor}" />
        <Setter Property="Color" Value="{DynamicResource PrimaryLabelTextColor}" />
        <Setter Property="CircleColor" Value="{DynamicResource PrimaryLabelTextColor}" />
    </Style>
</ResourceDictionary>
